# ===========================================
# ZedReq Backoffice - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# Required: BACKOFFICE_JWT_SECRET_KEY, BACKOFFICE_CORS_ORIGINS (and DB credentials).

# ===========================================
# PostgreSQL Database
# ===========================================
# Option A: Full connection URL (overrides individual vars below if set)
# BACKOFFICE_DATABASE_URL=postgresql://user:password@localhost:5432/zedreq_backoffice

# Option B: Individual connection settings
BACKOFFICE_DB_HOST=localhost
BACKOFFICE_DB_PORT=5432
BACKOFFICE_DB_NAME=zedreq_backoffice
BACKOFFICE_DB_USER=postgres
BACKOFFICE_DB_PASSWORD=your_db_password

# Connection pool (optional; defaults shown)
BACKOFFICE_DB_POOL_MIN=5
BACKOFFICE_DB_POOL_SIZE=20
BACKOFFICE_DB_POOL_MAX_OVERFLOW=40

# Log SQL statements (optional; set to true for debugging)
# SQL_ECHO=false

# ===========================================
# JWT Authentication (required)
# ===========================================
# Generate a strong random key for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKOFFICE_JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
BACKOFFICE_JWT_ALGORITHM=HS256
BACKOFFICE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===========================================
# CORS (required)
# ===========================================
# Comma-separated allowed origins for the API (frontend dev server and production URL)
BACKOFFICE_CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:5173

# ===========================================
# Server
# ===========================================
BACKOFFICE_SERVER_HOST=127.0.0.1
BACKOFFICE_SERVER_PORT=5001
BACKOFFICE_DEBUG=true

# Frontend URL (used for redirects / links; backend serves built frontend at same host in production)
BACKOFFICE_FRONTEND_URL=http://localhost:3001
