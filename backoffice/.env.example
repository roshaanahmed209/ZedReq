<<<<<<< HEAD
# SQL Query Echo (for debugging - set to 'true' to see SQL queries in logs)
SQL_ECHO=false

# ============================================
# JWT Authentication Configuration
# ============================================
# REQUIRED: Generate a strong secret key for JWT token signing
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
BACKOFFICE_JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production

# JWT Algorithm (default: HS256)
BACKOFFICE_JWT_ALGORITHM=HS256

# JWT Token Expiration (in minutes)
# Default: 1440 minutes (24 hours)
BACKOFFICE_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# CORS Configuration
# ============================================
# REQUIRED: Comma-separated list of allowed origins
# Add your frontend URLs here (comma-separated, no spaces)
BACKOFFICE_CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://127.0.0.1:3001

# ============================================
# Server Configuration
# ============================================
# Server host (default: 127.0.0.1)
BACKOFFICE_SERVER_HOST=127.0.0.1

# Server port (default: 5001)
BACKOFFICE_SERVER_PORT=5001

# Debug mode (true/false)
# Set to false in production!
BACKOFFICE_DEBUG=true

# ============================================
# Frontend Configuration
# ============================================
# Frontend URL (used for redirects and CORS)
BACKOFFICE_FRONTEND_URL=http://localhost:3001

# ============================================
# Production Notes
# ============================================
# 1. Change BACKOFFICE_JWT_SECRET_KEY to a strong random value
# 2. Set BACKOFFICE_DEBUG=false in production
# 3. Update BACKOFFICE_CORS_ORIGINS with your production frontend URL
# 4. Use strong database passwords
# 5. Consider using BACKOFFICE_DATABASE_URL for cloud deployments
# 6. Review and adjust connection pool settings based on your load
=======
