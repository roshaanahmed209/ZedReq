# Copy to .env and adjust. Used by run_backends.py (optional dotenv load) and app settings.

# --- Launcher (run_backends.py) ---
# both | main | backoffice  (use main or backoffice on Render: one service per app)
START_BACKENDS=both

ZEDREQ_HOST=0.0.0.0
ZEDREQ_PORT=5000

BACKOFFICE_HOST=0.0.0.0
BACKOFFICE_PORT=5001

# Render sets PORT automatically; with START_BACKENDS=main or backoffice, PORT is used
# if ZEDREQ_PORT / BACKOFFICE_PORT is not set.
# PORT=10000

# Optional dev: UVICORN_RELOAD=1 (only when START_BACKENDS is main or backoffice)

# --- Main ZedReq API: see backend/config/settings.py for full list ---
# --- Backoffice API: see backoffice/.env.example ---
