# ===========================================
# ZedRec Backend Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# ===========================================
# Server Configuration
# ===========================================

# Debug mode (true/false)
DEBUG=true

# ===========================================
# PostgreSQL Database Configuration
# ===========================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=zedreq
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-database-password

# Full PostgreSQL connection URL (alternative to individual settings above)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/zedreq

# Connection pool settings
DB_POOL_MIN=1
DB_POOL_SIZE=50
DB_POOL_MAX_OVERFLOW=100

# ===========================================
# JWT Authentication Configuration
# ===========================================

# Secret key for JWT signing (generate a strong random key for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production

# JWT algorithm
JWT_ALGORITHM=HS256

# Token expiration times
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS Configuration
# ===========================================

# Allowed origins for CORS (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===========================================
# Security Configuration
# ===========================================

BCRYPT_ROUNDS=12

# ===========================================
# Pagination
# ===========================================

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ===========================================
# Redis Configuration (for feed caching and LMS dashboard caching)
# ===========================================

# Redis connection (optional - app works without Redis, falls back to direct database queries)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Alternative: Full Redis URL (if provided, takes precedence over individual settings above)
REDIS_URL=redis://localhost:6379/0

# Cache TTL in seconds
REDIS_CACHE_TTL=300

# ===========================================
# AI & Vector Database Configuration
# ===========================================

# OpenAI API Key (for question generation)
OPENAI_API_KEY=your-openai-api-key-here

# Qdrant Vector Database (optional - for semantic search and content storage)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key-here

# ===========================================
# Threading & Parallel Processing Configuration
# ===========================================

# Vec Agent - Parallel entity indexing
VEC_SYNC_MAX_WORKERS=3

# Seez Agent - Parallel answer evaluation
SEEZ_EVAL_MAX_WORKERS=5

# Azel Agent - Parallel web operations
AZEL_WEB_MAX_WORKERS=3

# Nemz Agent - Parallel multi-type search
NEMZ_SEARCH_MAX_WORKERS=3

# ===========================================
# Rate Limiting Configuration
# ===========================================

# OpenAI API Rate Limiting
OPENAI_MAX_CONCURRENT_REQUESTS=5
OPENAI_RATE_LIMIT_RPM=500
OPENAI_RATE_LIMIT_TPM=1000000
OPENAI_REQUEST_TIMEOUT=30

# Google Search API Rate Limiting
GOOGLE_SEARCH_MAX_CONCURRENT=3
GOOGLE_SEARCH_DELAY=2.0
GOOGLE_SEARCH_MAX_RETRIES=3

# Qdrant API Rate Limiting
QDRANT_MAX_CONCURRENT_OPS=10
QDRANT_REQUEST_TIMEOUT=10

# ===========================================
# Retry Logic Configuration
# ===========================================

# General API retry settings
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY=1.0
API_RETRY_MAX_DELAY=60.0
API_RETRY_MULTIPLIER=2.0

# OpenAI specific retry settings
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BACKOFF_BASE=2

# ===========================================
# Circuit Breaker Configuration
# ===========================================

# Circuit breaker settings for external APIs
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3

# ===========================================
# Cloudinary Configuration (for media storage)
# ===========================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ===========================================
# Firebase Configuration (for messaging)
# ===========================================

# Firebase Project ID
FIREBASE_PROJECT_ID=zedreg-messages

# Firebase Realtime Database URL
# Format: https://<project-id>-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://zedreg-messages-default-rtdb.firebaseio.com/

# Path to Firebase service account credentials JSON file
# Download from: Firebase Console > Project Settings > Service Accounts
# Generate new private key and save the JSON file
# IMPORTANT: Never commit this file to git!
FIREBASE_CREDENTIALS_PATH=backend/firebase/credentials.json

# Firebase API Key (for REST API fallback)
# Get from: Firebase Console > Project Settings > General > Web API Key
FIREBASE_API_KEY=your-firebase-api-key-here
