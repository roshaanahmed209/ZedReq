# ===========================================
# ZedRec Frontend Environment Configuration
# ===========================================
# Copy this file to .env and update the values

# ===========================================
# API Configuration
# ===========================================

# Backend API URL
VITE_API_URL=http://localhost:5000

# Public site URL (canonical origin, no trailing slash). Used for footer and marketing links.
# The Vite config reads ZEDREQ_URL or VITE_ZEDREQ_URL from the repo root .env and exposes it as VITE_ZEDREQ_URL.
# Example: ZEDREQ_URL=https://zedreq.ai
ZEDREQ_URL=http://localhost:3000

# Primary contact email (support, privacy, legal). Shown across the app and EmailJS templates.
ZEDREQ_EMAIL=zed.req@yahoo.com

# ===========================================
# App Settings
# ===========================================

# Application mode
VITE_APP_ENV=development

# Application name
VITE_APP_NAME=ZedRec

# ===========================================
# Paddle Checkout (Pro / Premium paid plans)
# ===========================================
# Without these, /checkout shows "not configured" and only Free plan works.
# Get values from Paddle Billing (https://www.paddle.com) — use Sandbox for testing.
#
# Client-side token for Paddle.js v2 (Developer tools → Authentication / Client token).
# VITE_PADDLE_CLIENT_TOKEN=test_xxxxxxxx...
#
# Price IDs for each plan (Catalog → Products → Prices, copy Price ID).
# VITE_PADDLE_PRICE_PRO=pri_xxxxxxxx...
# VITE_PADDLE_PRICE_PREMIUM=pri_xxxxxxxx...
#
# sandbox (default) or production
# VITE_PADDLE_ENV=sandbox

# ===========================================
# Cloudinary Configuration (for media uploads)
# ===========================================

VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset